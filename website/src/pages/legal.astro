---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Legal — DARLNG"
	description="Legal notice for darlng.com — publisher, contact, and hosting details."
>
	<section class="py-12 md:py-16">
		<h1 class="font-display font-extrabold text-headline leading-[1.05]">Legal notice</h1>
		<p class="text-base text-text-muted max-w-prose mt-4">
			This page says who publishes darlng.com and who hosts it.
		</p>

		<h2 class="text-2xl leading-tight font-display font-bold mt-12">Publisher</h2>
		<p class="text-base text-text-muted max-w-prose mt-4">
			DARLNG, independent artist. Contact:
			<a
				href="mailto:hello@darlng.com"
				class="text-text underline underline-offset-4 transition-colors hover:text-accent"
			>hello@darlng.com</a>.
		</p>
		<!-- Placeholder: a full legal name and postal address belong here if a
		     jurisdiction ever requires them for this site. They are deliberately
		     omitted while DARLNG operates as an independent artist without a
		     registered business address. -->

		<h2 class="text-2xl leading-tight font-display font-bold mt-12">Hosting</h2>
		<p class="text-base text-text-muted max-w-prose mt-4">
			This site is hosted by Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Germany.
		</p>

		<p class="text-sm text-text-muted mt-12">Last updated: 10 August 2026</p>
	</section>
</Layout>
