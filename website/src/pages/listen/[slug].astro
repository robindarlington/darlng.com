---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PlatformButton from '../../components/PlatformButton.astro';
import { releases, socials } from '../../data/releases';
import type { Release } from '../../data/releases';

export const getStaticPaths = (() => {
	return releases.map((release) => ({
		params: { slug: release.slug },
		props: { release },
	}));
}) satisfies GetStaticPaths;

interface Props {
	release: Release;
}

const { release } = Astro.props;

// music:musician points at the DARLNG Spotify artist profile — reused from the socials
// list (never a second copy of the literal) so `og:type="music.album"` pages declare the
// correct artist per ogp.me. Fail loudly if that entry is ever removed, matching the
// fail-loud posture releases.ts already uses for its other invariants.
const spotifyArtist = socials.find((social) => social.platform === 'spotify');
if (!spotifyArtist) {
	throw new Error(
		'listen/[slug].astro: socials in releases.ts is missing a "spotify" entry required for the music:musician OG property.'
	);
}
---

<Layout
	title={`Listen to ${release.title} — DARLNG`}
	description={`Listen to ${release.title} by ${release.artistLine} on every platform.`}
	image={`/og/${release.slug}.png`}
	type="music.album"
	musician={spotifyArtist.url}
	releaseDate={`${release.year}`}
>
	<div class="py-12 md:py-16">
		<a href="/" class="text-base font-semibold text-text-muted transition hover:text-accent">
			&larr; Back to DARLNG
		</a>

		<div class="max-w-md mx-auto px-4 mt-8 flex flex-col items-center text-center">
			<Picture
				src={release.cover}
				formats={['avif', 'webp']}
				widths={[320, 384, 640, 768]}
				sizes="(min-width: 640px) 384px, 320px"
				fit="cover"
				loading="eager"
				alt={`${release.title} cover art`}
				class="rounded-card max-w-xs sm:max-w-sm w-full"
			/>

			<p class="text-sm font-semibold uppercase tracking-wide text-accent mt-8">LISTEN EVERYWHERE</p>
			<h1 class="text-headline leading-[1.05] font-display font-extrabold mt-2">{release.title}</h1>
			<p class="text-base font-semibold text-text-muted mt-4">{release.artistLine} &middot; {release.year}</p>
			<p class="text-base text-text mt-4">Listen to {release.title} everywhere — pick your platform.</p>

			<nav aria-label={`Listen to ${release.title} on these platforms`} class="w-full mt-8">
				<ul class="flex flex-col gap-3">
					{
						release.platforms.map((link) => (
							<li>
								<PlatformButton
									href={link.url}
									label={link.label}
									platform={link.platform}
									releaseTitle={release.title}
								/>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</Layout>
