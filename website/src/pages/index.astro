---
import Layout from '../layouts/Layout.astro';
import { Picture, getImage } from 'astro:assets';
import { ChevronRight } from '@lucide/astro';
import BrandIcon from '../components/BrandIcon.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import DiscographyCard from '../components/DiscographyCard.astro';
import NewsletterForm from '../components/NewsletterForm';
import { platformIcons } from '../data/platform-icons';
import { latestRelease, releases } from '../data/releases';
import type { Platform } from '../data/releases';
import { HERO_IMAGE_PARAMS } from '../data/hero-image';

const backCatalog = releases.filter((release) => !release.isLatest);

// Strip trailing slash(es) so `${listmonkUrl}/api/public/subscription` never
// produces a double-slash path if the operator pastes a trailing-slash URL
// into Coolify's env-var UI (see DEPLOY.md Section 2).
const listmonkUrl = import.meta.env.PUBLIC_LISTMONK_URL?.replace(/\/+$/, '');
const listmonkListUuid = import.meta.env.PUBLIC_LISTMONK_LIST_UUID;
const newsletterEnabled = Boolean(listmonkUrl && listmonkListUuid);

const heroPlatforms: Platform[] = ['spotify', 'appleMusic', 'youtube'];
const ctaLinks = heroPlatforms.map((platform) => {
	const link = latestRelease.platforms.find((l) => l.platform === platform);
	if (!link) {
		throw new Error(
			`releases.ts: latest release "${latestRelease.slug}" is missing a "${platform}" platform link required by the hero CTA row.`
		);
	}
	return link;
});
const { youtubeEmbed } = latestRelease;

// LCP preload: shares HERO_IMAGE_PARAMS with the hero <Picture> below so the
// preloaded candidates are always byte-identical URLs (no hand-kept parity).
const heroAvif = await getImage({
	src: latestRelease.cover,
	format: 'avif',
	...HERO_IMAGE_PARAMS,
});
const heroPreload = { srcset: heroAvif.srcSet.attribute, sizes: '100vw' };
---

<Layout
	title="DARLNG — Afro / RnB / Pop"
	description="DARLNG is an independent Afro / RnB / Pop artist. New music when it is ready, on nobody's schedule but his own."
	image="/og/home.png"
	type="website"
	preloadImage={heroPreload}
>
	<section id="hero" class="relative -mx-4 md:-mx-6 xl:-mx-8 min-h-svh lg:min-h-[85vh] flex overflow-hidden">
		<Picture
			src={latestRelease.cover}
			formats={['avif', 'webp']}
			sizes="100vw"
			priority
			alt={`DARLNG — ${latestRelease.title} cover art`}
			class="absolute inset-0 h-full w-full object-cover object-[35%_28%]"
			{...HERO_IMAGE_PARAMS}
		/>
		<div class="hero-scrim absolute inset-0" aria-hidden="true"></div>

		<div class="relative z-10 w-full flex flex-col justify-end px-4 pb-12 md:px-6 md:pb-16 xl:px-8 lg:grid lg:grid-cols-[1.1fr_1fr] lg:gap-12 lg:items-end">
			<div class="flex flex-col">
				<p class="text-sm font-semibold uppercase tracking-wide text-accent">OUT NOW</p>
				<h1 class="text-hero leading-[1.05] font-display font-extrabold mt-2">{latestRelease.title}</h1>
				<p class="text-base font-semibold text-text mt-4">{latestRelease.artistLine}</p>

				<div class="flex flex-wrap gap-2 md:gap-3 mt-8">
					{
						ctaLinks.map((link) => (
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 rounded-full border border-accent text-accent py-3 px-6 font-semibold transition hover:bg-accent hover:text-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-95"
							>
								<BrandIcon icon={platformIcons[link.platform]!} class="w-[18px] h-[18px]" />
								{link.label}
							</a>
						))
					}
				</div>

				<a
					href={`/listen/${latestRelease.slug}`}
					class="inline-flex items-center gap-1 text-accent font-semibold mt-6 hover:underline w-fit min-h-11"
				>
					Listen everywhere
					<ChevronRight size={16} />
				</a>
			</div>

			{
				youtubeEmbed && (
					<div class="mt-8 max-w-xl lg:mt-0 lg:max-w-lg">
						<YouTubeFacade
							videoId={youtubeEmbed.videoId}
							titleForA11y={youtubeEmbed.titleForA11y}
							thumbnail={latestRelease.cover}
						/>
					</div>
				)
			}
		</div>
	</section>

	<section class="py-16" aria-labelledby="catalog-heading">
		<h2 id="catalog-heading" class="text-2xl leading-tight font-display font-bold">The Catalog</h2>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
			{backCatalog.map((release) => <DiscographyCard release={release} />)}
		</div>
	</section>

	{
		newsletterEnabled && listmonkUrl && listmonkListUuid && (
			<section id="newsletter" aria-labelledby="newsletter-heading" class="py-12 md:py-16">
				<h2 id="newsletter-heading" class="text-2xl leading-tight font-display font-bold">
					New Music, No Schedule.
				</h2>
				<p class="text-base text-text-muted mt-2 max-w-md">
					Get told the moment it drops — straight to your inbox, nothing else.
				</p>
				<div class="mt-6">
					<NewsletterForm client:visible listmonkUrl={listmonkUrl} listUuid={listmonkListUuid} />
				</div>
				<noscript>
					<p class="text-sm text-text-muted mt-3">
						This form needs JavaScript. Find DARLNG on Spotify, Instagram, or TikTok below.
					</p>
				</noscript>
				<p id="newsletter-privacy" class="text-sm text-text-muted mt-3">No spam. Unsubscribe anytime.</p>
			</section>
		)
	}
</Layout>
