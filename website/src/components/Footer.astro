---
import BrandIcon from './BrandIcon.astro';
import { socials } from '../data/releases';
import { socialIcons } from '../data/social-icons';
---

<footer class="bg-surface py-12 md:py-16">
	<div
		class="mx-auto w-full max-w-7xl px-4 md:px-6 xl:px-8 flex flex-col items-center gap-6 text-center md:grid md:grid-cols-3 md:items-center md:text-left md:gap-8"
	>
		<div>
			<p class="font-display font-bold text-lg uppercase tracking-wide">DARLNG</p>
			<p class="text-sm text-text-muted tracking-wide">Afro / RnB / Pop</p>
		</div>
		<nav aria-label="Follow DARLNG" class="flex items-center justify-center gap-4">
			{
				socials.map((social) => (
					<a
						href={social.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Follow DARLNG on ${social.label}`}
						class="social-icon-link flex items-center justify-center min-h-11 min-w-11 rounded-full text-text-muted transition-colors duration-150 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-95"
					>
						<BrandIcon icon={socialIcons[social.platform]} class="w-5 h-5" />
					</a>
				))
			}
		</nav>
		<p class="text-sm text-text-muted md:text-right">© 2026 DARLNG. All rights reserved.</p>
	</div>
</footer>
