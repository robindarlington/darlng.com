---
import BrandIcon from './BrandIcon.astro';
import { socials } from '../data/releases';
import { socialIcons } from '../data/social-icons';
---

<header class="bg-surface sticky top-0 z-50 border-b border-white/5 h-16 md:h-18">
	<div class="mx-auto w-full max-w-7xl px-4 md:px-6 xl:px-8 h-full flex items-center justify-between">
		<a
			href="/"
			class="font-display font-bold text-xl tracking-normal md:text-2xl md:tracking-wide uppercase text-text transition-colors duration-200 hover:text-accent"
		>
			DARLNG
		</a>
		<nav aria-label="Follow DARLNG (header)" class="flex items-center gap-1 md:gap-4">
			{
				socials.map((social) => (
					<a
						href={social.url}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Follow DARLNG on ${social.label}`}
						class="social-icon-link flex items-center justify-center min-h-11 min-w-11 rounded-full text-text-muted transition-colors duration-150 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-95"
					>
						<BrandIcon icon={socialIcons[social.platform]} class="w-5 h-5" />
					</a>
				))
			}
		</nav>
	</div>
</header>
