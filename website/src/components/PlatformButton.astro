---
// Full-width prominent listen-page platform button — surface fill, pill,
// brand icon (or neutral fallback), external-link affordance. See
// 03-UI-SPEC.md "Platform button anatomy".
import { ExternalLink } from '@lucide/astro';
import BrandIcon from './BrandIcon.astro';
import { platformIcons } from '../data/platform-icons';
import type { Platform } from '../data/releases';

interface Props {
	href: string;
	label: string;
	platform: Platform;
	releaseTitle: string;
}

const { href, label, platform, releaseTitle } = Astro.props;
const icon = platformIcons[platform];
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={`Listen to ${releaseTitle} on ${label} (opens in new tab)`}
	class="platform-button w-full flex items-center gap-3 bg-surface text-text font-semibold text-base py-4 px-6 rounded-full border border-transparent transition duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-[0.98]"
>
	{
		icon ? (
			<BrandIcon icon={icon} class="w-6 h-6 shrink-0" />
		) : (
			<ExternalLink size={24} class="shrink-0 text-text-muted" />
		)
	}
	<span class="flex-1 text-left">{label}</span>
	<ExternalLink size={18} class="shrink-0 text-text-muted" />
</a>
