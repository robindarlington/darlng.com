---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import unboundedWoff2 from '@fontsource-variable/unbounded/files/unbounded-latin-wght-normal.woff2?url';
import manropeWoff2 from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'music.album';
	canonical?: string;
	musician?: string;
	noindex?: boolean;
}

const {
	title = 'DARLNG',
	description = 'DARLNG is an independent Afro / RnB / Pop artist. Listen to the latest release and follow DARLNG everywhere.',
	image = '/og/home.png',
	type = 'website',
	canonical,
	musician,
	noindex = false,
} = Astro.props;

// Absolute URLs are built from `Astro.site` (never string concatenation — RESEARCH
// Pitfall 1) so og:image / og:url / twitter:image / canonical always resolve to a
// real, fetchable https://darlng.com/... URL regardless of which page renders them.
if (!Astro.site) {
	throw new Error(
		'Layout.astro: Astro.site is not set. Set `site: "https://darlng.com"` in astro.config.mjs — absolute OG/Twitter URLs cannot be built without it.'
	);
}
const ogImageUrl = new URL(image, Astro.site).href;
const pageUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? (
			<meta name="robots" content="noindex" />
		) : (
			<link rel="canonical" href={pageUrl} />
		)}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${title} — DARLNG`} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="DARLNG" />
		{musician && <meta property="music:musician" content={musician} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href={unboundedWoff2} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={manropeWoff2} as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:bg-surface focus:text-text focus:px-4 focus:py-2 focus:rounded-card"
		>
			Skip to content
		</a>
		<Header />
		<main id="main" class="mx-auto w-full max-w-7xl px-4 md:px-6 xl:px-8">
			<slot />
		</main>
		<Footer />
	</body>
</html>
